[Unit]
Description=Formation Pro 360 frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=formation360
Group=formation360
WorkingDirectory=/opt/formation-pro-360
EnvironmentFile=/etc/formation-pro-360/frontend.env
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/formation-pro-360/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/formation-pro-360
UMask=0027

[Install]
WantedBy=multi-user.target
